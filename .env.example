# ---------------------------------------------------------------------------
# X-Aegis backend — environment configuration
# Copy to .env and fill in. Everything here has a working default except
# DATABASE_URL and the vendor credentials.
# ---------------------------------------------------------------------------

# TimescaleDB / PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/aegis

# --- Live FX ingestion (services/forex_ingester.py) ------------------------

# Official vendor APIs. The ingester tries FX_PRIMARY_SOURCE first and fails
# over to the remaining vendors; the chain ends at a keyless open endpoint, so
# ingestion works even with none of these set.
FIXER_API_KEY=
OPEN_EXCHANGE_RATES_APP_ID=
FX_PRIMARY_SOURCE=fixer
EXCHANGERATE_API_URL=https://open.er-api.com/v6/latest/USD

# Parallel-market ("street rate") feed. Any JSON endpoint shaped like
#   {"base": "USD", "timestamp": 1755000000, "rates": {"NGN": 1750.0, "KES": 132.4}}
# The volatility score prefers this feed when it is available, because it is the
# rate NGN/KES holders actually transact at.
PARALLEL_MARKET_API_URL=
PARALLEL_MARKET_API_KEY=
PARALLEL_MARKET_SOURCE=ParallelMarket

# Scheduling and freshness
FX_INGEST_INTERVAL_SECONDS=900   # 15 minutes
FX_HTTP_TIMEOUT_SECONDS=15
FX_MAX_RATE_AGE_MINUTES=45       # stale-rate guard for continuous feeds
FX_MAX_CLOCK_SKEW_MINUTES=5
FX_DAILY_SOURCE_MAX_AGE_MINUTES=1500  # budget for once-a-day fallback feeds

# --- Sentiment ingestion ---------------------------------------------------
TWITTER_BEARER_TOKEN=

# --- Keeper bot ------------------------------------------------------------
MODEL_API_BASE_URL=http://localhost:8000
KEEPER_ADMIN_TOKEN=

# --- Keeper signing key (BK-11: secure key management) --------------------
# Backend for resolving the keeper's Stellar signing seed:
#   aws_kms  — production. Seed stored ONLY as a KMS-encrypted ciphertext.
#   vault    — local dev / self-hosted. Seed in HashiCorp Vault KV v2.
#   env_key  — tests / throwaway dev only. Plaintext seed below.
SIGNING_BACKEND=env_key

# env_key backend
ADMIN_SECRET_KEY=

# aws_kms backend (envelope encryption — AWS KMS cannot sign ed25519 directly)
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=alias/aegis-keeper
ADMIN_SECRET_KEY_CIPHERTEXT=   # base64 of the KMS-encrypted Stellar seed

# vault backend
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_KEY_PATH=aegis/keeper-signing-key
VAULT_KEY_FIELD=stellar_secret

# IP allowlist for the key-management endpoints
# (POST /keeper/emergency-revocate, POST /keeper/rotate-key). Comma-separated
# IPs / CIDRs; empty disables the check (local dev).
KEY_ACCESS_IP_ALLOWLIST=
KEY_ACCESS_TRUST_FORWARDED_FOR=false
